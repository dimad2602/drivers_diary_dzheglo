# Скопируйте в .env:  cp .env.example .env  (PowerShell: Copy-Item .env.example .env)
# Все значения необязательны — по умолчанию сервер работает без настройки.

# Строка подключения к БД. По умолчанию — файл driver_diary.db рядом с backend/.
# DATABASE_URL=sqlite:///./driver_diary.db

# Заполнять пустую БД поездками из data/trips.json при старте.
# SEED_ON_START=true
