{
  "components": {
    "schemas": {
      "ByPayment": {
        "description": "Разбивка по способу оплаты. Оба ключа есть всегда, даже если поездок не было.",
        "properties": {
          "card": {
            "$ref": "#/components/schemas/PaymentBreakdown"
          },
          "cash": {
            "$ref": "#/components/schemas/PaymentBreakdown"
          }
        },
        "required": [
          "cash",
          "card"
        ],
        "title": "ByPayment",
        "type": "object"
      },
      "DaySummary": {
        "properties": {
          "by_payment": {
            "$ref": "#/components/schemas/ByPayment"
          },
          "commission": {
            "title": "Commission",
            "type": "integer"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "net": {
            "description": "На руки: выручка минус комиссия",
            "title": "Net",
            "type": "integer"
          },
          "revenue": {
            "title": "Revenue",
            "type": "integer"
          },
          "trips_count": {
            "title": "Trips Count",
            "type": "integer"
          }
        },
        "required": [
          "date",
          "trips_count",
          "revenue",
          "commission",
          "net",
          "by_payment"
        ],
        "title": "DaySummary",
        "type": "object"
      },
      "ErrorResponse": {
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "PaymentBreakdown": {
        "properties": {
          "commission": {
            "description": "Комиссия",
            "title": "Commission",
            "type": "integer"
          },
          "net": {
            "description": "На руки: выручка минус комиссия",
            "title": "Net",
            "type": "integer"
          },
          "revenue": {
            "description": "Выручка (сумма поездок)",
            "title": "Revenue",
            "type": "integer"
          },
          "trips_count": {
            "description": "Число поездок",
            "title": "Trips Count",
            "type": "integer"
          }
        },
        "required": [
          "trips_count",
          "revenue",
          "commission",
          "net"
        ],
        "title": "PaymentBreakdown",
        "type": "object"
      },
      "PaymentMethod": {
        "enum": [
          "cash",
          "card"
        ],
        "title": "PaymentMethod",
        "type": "string"
      },
      "Trip": {
        "description": "Поездка в ответах API.",
        "properties": {
          "amount": {
            "description": "Сумма поездки, целое число больше нуля",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "type": "integer"
          },
          "commission": {
            "description": "Комиссия, от 0 до суммы поездки включительно",
            "minimum": 0.0,
            "title": "Commission",
            "type": "integer"
          },
          "end": {
            "description": "Окончание поездки, ISO 8601, строго позже начала",
            "examples": [
              "2026-10-01T08:10:00+05:00"
            ],
            "title": "End",
            "type": "string"
          },
          "id": {
            "description": "Уникальный идентификатор. Повторная отправка с тем же id не создаёт дубль.",
            "examples": [
              "t1"
            ],
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id",
            "type": "string"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "start": {
            "description": "Начало поездки, ISO 8601 со смещением пояса",
            "examples": [
              "2026-10-01T08:10:00+05:00"
            ],
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "amount",
          "payment",
          "commission"
        ],
        "title": "Trip",
        "type": "object"
      },
      "TripCreate": {
        "additionalProperties": false,
        "description": "Тело POST /trips. `id` задаёт клиент — он же служит ключом идемпотентности.",
        "properties": {
          "amount": {
            "description": "Сумма поездки, целое число больше нуля",
            "exclusiveMinimum": 0.0,
            "title": "Amount",
            "type": "integer"
          },
          "commission": {
            "description": "Комиссия, от 0 до суммы поездки включительно",
            "minimum": 0.0,
            "title": "Commission",
            "type": "integer"
          },
          "end": {
            "description": "Окончание поездки, ISO 8601, строго позже начала",
            "examples": [
              "2026-10-01T08:10:00+05:00"
            ],
            "title": "End",
            "type": "string"
          },
          "id": {
            "description": "Уникальный идентификатор. Повторная отправка с тем же id не создаёт дубль.",
            "examples": [
              "t1"
            ],
            "maxLength": 64,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:-]+$",
            "title": "Id",
            "type": "string"
          },
          "payment": {
            "$ref": "#/components/schemas/PaymentMethod"
          },
          "start": {
            "description": "Начало поездки, ISO 8601 со смещением пояса",
            "examples": [
              "2026-10-01T08:10:00+05:00"
            ],
            "title": "Start",
            "type": "string"
          }
        },
        "required": [
          "id",
          "start",
          "end",
          "amount",
          "payment",
          "commission"
        ],
        "title": "TripCreate",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "description": "Ключ доступа. Если на сервере `API_KEY` пуст, проверка отключена.",
        "in": "header",
        "name": "X-API-Key",
        "type": "apiKey"
      }
    }
  },
  "info": {
    "description": "\nAPI дневника смен водителя: поездки за выбранный день и сводка за день.\n\n* Все запросы к `/api/v1` требуют заголовок **X-API-Key** (кнопка *Authorize*).\n* `POST /trips` идемпотентен: `id` поездки задаёт клиент, повтор не создаёт дубль.\n* День определяется по дате начала поездки в её собственном часовом поясе.\n* «На руки» = выручка − комиссия.\n",
    "title": "Driver Diary API",
    "version": "1.0.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/v1/summary": {
      "get": {
        "description": "Число поездок, выручка, комиссия, «на руки» (выручка − комиссия) и разбивка по оплате.",
        "operationId": "getDaySummary",
        "parameters": [
          {
            "description": "День в формате YYYY-MM-DD",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "День в формате YYYY-MM-DD",
              "examples": [
                "2026-10-01"
              ],
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DaySummary"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Сводка за день",
        "tags": [
          "summary"
        ]
      }
    },
    "/api/v1/trips": {
      "get": {
        "description": "Поездки, начавшиеся в выбранный день по местному времени поездки, по возрастанию начала.",
        "operationId": "listTrips",
        "parameters": [
          {
            "description": "День в формате YYYY-MM-DD",
            "in": "query",
            "name": "date",
            "required": true,
            "schema": {
              "description": "День в формате YYYY-MM-DD",
              "examples": [
                "2026-10-01"
              ],
              "format": "date",
              "title": "Date",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/Trip"
                  },
                  "title": "Response Listtrips",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Поездки за день",
        "tags": [
          "trips"
        ]
      },
      "post": {
        "description": "Идемпотентное добавление: `id` задаёт клиент и служит ключом идемпотентности.",
        "operationId": "createTrip",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TripCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "description": "Повтор той же поездки: дубль не создан, возвращена сохранённая"
          },
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Trip"
                }
              }
            },
            "description": "Поездка создана"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Unauthorized"
          },
          "409": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Поездка с таким id уже есть, но с другими данными"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "security": [
          {
            "APIKeyHeader": []
          }
        ],
        "summary": "Добавить поездку",
        "tags": [
          "trips"
        ]
      }
    }
  },
  "tags": [
    {
      "description": "Поездки водителя",
      "name": "trips"
    },
    {
      "description": "Сводка за день",
      "name": "summary"
    }
  ]
}
