# Скопируйте в .env (Copy-Item .env.example .env) и перегенерируйте env.g.dart:
#   dart run build_runner build --delete-conflicting-outputs

# Адрес backend. Windows / iOS-симулятор: http://127.0.0.1:8000
# Android-эмулятор: http://10.0.2.2:8000
BASE_URL=http://127.0.0.1:8000

# Ключ по умолчанию: при первом запуске сохраняется в secure storage.
# Должен совпадать с API_KEY в backend/.env.
API_KEY=dev-api-key
