# Скопируйте в .env (PowerShell: Copy-Item .env.example .env) и перегенерируйте env.g.dart:
#   dart run build_runner build --delete-conflicting-outputs
# После этого приложение нужно перезапустить целиком (hot reload адрес не обновит).

# Адрес backend.
#  - Windows, iOS-симулятор: http://127.0.0.1:8000
#  - Android-эмулятор: менять не нужно, 127.0.0.1 автоматически заменяется на 10.0.2.2
#  - реальное устройство: IP компьютера в сети, например http://192.168.1.10:8000
#    (backend при этом запускают с --host 0.0.0.0)
BASE_URL=http://127.0.0.1:8000
